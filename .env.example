# Local development values. Copy to .env.local and never commit real credentials.
GROQ_API_KEY=

# Supabase project (Settings -> API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret service-role key (server only). Optional: enables instant account creation, confirmed emails
# and password resets from the admin console. Without it, students confirm their email after signing up.
SUPABASE_SERVICE_ROLE_KEY=
